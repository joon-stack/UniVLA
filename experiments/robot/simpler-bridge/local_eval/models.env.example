# Copy this file and fill in paths for each policy family.

ROOT=/NHNHOME/WORKSPACE/0526040036_A/BASE/user/01/youngjoonjeong

# UniVLA / local latent-action / MVP-LAM-style policies:
# CKPT_PATH must be a Hugging Face model directory.
# ACTION_DECODER_PATH must point to matching action_decoder-*.pt.
export CKPT_PATH=$ROOT/outputs/finetune_bridge/REPLACE_WITH_FINETUNE_RUN_DIR
export ACTION_DECODER_PATH=$CKPT_PATH/action_decoder-30000.pt
export UNIVLA_EVAL_ATTN_IMPLEMENTATION=sdpa
export PRED_ACTION_HORIZON=10
export SIM_BACKEND=physx_cpu
export RENDER_BACKEND=sapien_cpu
export VK_ICD_FILENAMES=/usr/share/vulkan/icd.d/lvp_icd.json
export __EGL_VENDOR_LIBRARY_FILENAMES=/dev/null

# SimpleREnv checkout. Use the maniskill3 branch checkout for UniVLA/MVP-LAM.
export SIMPLERENV_DIR=$ROOT/third_party/SimplerEnv-maniskill3

# Evaluation venv.
export PYTHON=$ROOT/.venvs/simplerenv-eval-py310/bin/python
